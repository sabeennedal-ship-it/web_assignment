<!-- ========================= -->
<!-- PROJECT 1: CSS Borders -->
<!-- ========================= -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CSS Borders - University of Jordan</title>
<style>

body{
    font-family: Arial;
    background:#f2f2f2;
    padding:20px;
}

h1{
    text-align:center;
    border:4px solid darkblue;
    padding:15px;
    border-radius:10px;
}

.box1{
    border:3px solid red;
    padding:20px;
    margin:20px;
    background:white;
}

.box2{
    border:3px dashed green;
    padding:20px;
    margin:20px;
    background:white;
}

.box3{
    border:3px dotted purple;
    padding:20px;
    margin:20px;
    background:white;
}

.box4{
    border-top:5px solid blue;
    border-right:5px dashed red;
    border-bottom:5px dotted green;
    border-left:5px double black;
    padding:20px;
    margin:20px;
    background:white;
}

</style>
</head>
<body>

<h1>CSS Borders Examples</h1>

<div class="box1">Solid Border</div>
<div class="box2">Dashed Border</div>
<div class="box3">Dotted Border</div>
<div class="box4">Mixed Border Styles</div>

</body>
</html>
