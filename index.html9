
<!-- PROJECT 5: CSS Box Model -->

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CSS Box Model</title>
<style>

body{
    font-family: Arial;
    background:#fafad2;
    padding:20px;
}

h1{
    text-align:center;
    background:darkorange;
    color:white;
    padding:15px;
}

.box-model{
    width:300px;
    padding:30px;
    border:10px solid blue;
    margin:40px auto;
    background:white;
    text-align:center;
}

</style>
</head>
<body>

<h1>CSS Box Model Example</h1>

<div class="box-model">
    Content Area <br>
    Padding: 30px <br>
    Border: 10px <br>
    Margin: 40px
</div>

</body>
</html>
